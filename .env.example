# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/food_ordering"

# JWT
JWT_SECRET="your-super-secret-jwt-key"
JWT_EXPIRES_IN="7d"

# Server
PORT=5555

# Food Ordering System (customer-facing web URL for QR code generation)
FOOD_ORDERING_SYSTEM_URL=http://localhost:3333

# RabbitMQ
RABBITMQ_URL="amqp://guest:guest@localhost:5672"
RABBITMQ_EXCHANGE="food_ordering.events"
RABBITMQ_PREFETCH=10

# Logging
LOG_LEVEL=info

# ELK (Elasticsearch)
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=food-ordering
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# Redis
REDIS_URL=redis://localhost:6379

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=food-images
