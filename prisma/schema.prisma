generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["food_ordering"]
}

model Branch {
  @@schema("food_ordering")
  id              Int              @id @default(autoincrement())
  name            String
  code            String           @unique
  address         String?
  phone           String?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  menuItems       MenuItem[]
  orders          Order[]
  queueTickets    QueueTicket[]
  tables          Table[]
  serviceRequests ServiceRequest[]
  ingredients     Ingredient[]
  payments        Payment[]
  addOns          AddOn[]
  addOnGroups     AddOnGroup[]
  users           User[]
  shifts          Shift[]
  promotions      Promotion[]
  webhooks        WebhookEndpoint[]
  tableSessions       TableSession[]
  gatewayTransactions GatewayTransaction[]
  companyTaxInfo      CompanyTaxInfo[]
  taxInvoices         TaxInvoice[]
  kdsStations         KDSStation[]
  systemSettings      SystemSetting[]
}

model MenuItem {
  @@schema("food_ordering")
  id                   Int                  @id @default(autoincrement())
  code                 String
  name                 String
  category             String
  price                Float
  image                String?
  description          String?
  rating               Float?
  reviewCount          Int                  @default(0)
  type                 MenuType             @default(SINGLE)
  isActive             Boolean              @default(true)
  branchId             Int?
  branch               Branch?              @relation(fields: [branchId], references: [id])
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  availableAddOns      MenuItemAddOn[]
  availableAddOnGroups MenuItemAddOnGroup[]
  nestedMenuConfig     NestedMenuConfig?
  orderItems           OrderItem[]
  setComponents        SetComponent[]
  ingredients          MenuItemIngredient[]

  @@index([branchId])
}

model SetComponent {
  @@schema("food_ordering")
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  quantity    Int      @default(1)
  menuItemId  Int
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
}

model AddOn {
  @@schema("food_ordering")
  id        Int              @id @default(autoincrement())
  name      String
  price     Float
  category  String
  isActive  Boolean          @default(true)
  branchId  Int?
  branch    Branch?          @relation(fields: [branchId], references: [id])
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  groups    AddOnGroupItem[]
  menuItems MenuItemAddOn[]

  @@index([branchId])
}

model AddOnGroup {
  @@schema("food_ordering")
  id          Int                  @id @default(autoincrement())
  name        String
  description String?
  price       Float
  category    String
  image       String?
  isActive    Boolean              @default(true)
  branchId    Int?
  branch      Branch?              @relation(fields: [branchId], references: [id])
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  items       AddOnGroupItem[]
  menuItems   MenuItemAddOnGroup[]

  @@index([branchId])
}

model AddOnGroupItem {
  @@schema("food_ordering")
  id           Int        @id @default(autoincrement())
  addOnId      Int
  addOnGroupId Int
  addOnGroup   AddOnGroup @relation(fields: [addOnGroupId], references: [id], onDelete: Cascade)
  addOn        AddOn      @relation(fields: [addOnId], references: [id], onDelete: Cascade)

  @@unique([addOnId, addOnGroupId])
}

model MenuItemAddOn {
  @@schema("food_ordering")
  id         Int      @id @default(autoincrement())
  menuItemId Int
  addOnId    Int
  addOn      AddOn    @relation(fields: [addOnId], references: [id], onDelete: Cascade)
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, addOnId])
}

model MenuItemAddOnGroup {
  @@schema("food_ordering")
  id           Int        @id @default(autoincrement())
  menuItemId   Int
  addOnGroupId Int
  addOnGroup   AddOnGroup @relation(fields: [addOnGroupId], references: [id], onDelete: Cascade)
  menuItem     MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, addOnGroupId])
}

model NestedMenuOption {
  @@schema("food_ordering")
  id                    Int                      @id @default(autoincrement())
  name                  String
  description           String?
  price                 Float                    @default(0)
  image                 String?
  type                  String                   @default("single")
  requireChildSelection Boolean                  @default(false)
  minChildSelections    Int?
  maxChildSelections    Int?
  parentId              Int?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  rootConfigs           NestedMenuConfigOption[]
  parent                NestedMenuOption?        @relation("NestedOptions", fields: [parentId], references: [id], onDelete: Cascade)
  children              NestedMenuOption[]       @relation("NestedOptions")
}

model NestedMenuConfig {
  @@schema("food_ordering")
  id               Int                      @id @default(autoincrement())
  menuItemId       Int                      @unique
  enabled          Boolean                  @default(true)
  requireSelection Boolean                  @default(true)
  minSelections    Int                      @default(1)
  maxSelections    Int                      @default(1)
  menuItem         MenuItem                 @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  rootOptions      NestedMenuConfigOption[]
}

model NestedMenuConfigOption {
  @@schema("food_ordering")
  id               Int              @id @default(autoincrement())
  configId         Int
  nestedOptionId   Int
  config           NestedMenuConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  nestedMenuOption NestedMenuOption @relation(fields: [nestedOptionId], references: [id], onDelete: Cascade)

  @@unique([configId, nestedOptionId])
}

model Order {
  @@schema("food_ordering")
  id               Int         @id @default(autoincrement())
  orderId          String      @unique
  totalAmount      Float
  totalItems       Int
  serviceCharge    Float       @default(0)
  vat              Float       @default(0)
  status           OrderStatus @default(PREPARING)
  tableNumber      String?
  sessionId        Int?
  splitFromOrderId Int?
  splitFromOrder   Order?      @relation("OrderSplit", fields: [splitFromOrderId], references: [id])
  splitOrders      Order[]     @relation("OrderSplit")
  branchId         Int?
  branch           Branch?     @relation(fields: [branchId], references: [id])
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  items            OrderItem[]
  payments         Payment[]

  @@index([branchId])
  @@index([splitFromOrderId])
}

model OrderItem {
  @@schema("food_ordering")
  id                    Int      @id @default(autoincrement())
  orderId               Int
  menuItemId            Int
  code                  String?
  quantity              Int      @default(1)
  price                 Float
  specialInstructions   String?
  diningOption          String
  status                String   @default("preparing")
  selectedAddOns        Json?
  selectedAddOnGroups   Json?
  selectedNestedOptions Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  menuItem              MenuItem @relation(fields: [menuItemId], references: [id])
  order                 Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model QueueTicket {
  @@schema("food_ordering")
  id            Int         @id @default(autoincrement())
  queueId       String      @unique
  queueNumber   Int
  orderType     String
  totalAmount   Float
  totalItems    Int
  status        QueueStatus @default(WAITING)
  estimatedTime Int?
  customerName  String?
  memberId      String?
  paymentMethod String?
  items         Json
  calledAt      DateTime?
  completedAt   DateTime?
  branchId      Int?
  branch        Branch?     @relation(fields: [branchId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([branchId])
}

model Table {
  @@schema("food_ordering")
  id            Int         @id @default(autoincrement())
  number        String
  capacity      Int
  status        TableStatus @default(AVAILABLE)
  size          String
  shape         String      @default("square")
  positionX     Float
  positionY     Float
  currentGuests Int?
  mergedWith    Int[]
  zone          String?
  branchId      Int?
  branch        Branch?     @relation(fields: [branchId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  staffAssignments TableStaffAssignment[]
  sessions      TableSession[]

  @@unique([branchId, number])
  @@index([branchId])
}

model ServiceRequest {
  @@schema("food_ordering")
  id          Int                  @id @default(autoincrement())
  requestId   String               @unique
  type        ServiceRequestType
  tableNumber String?
  details     String?
  items       String[]
  status      ServiceRequestStatus @default(PENDING)
  branchId    Int?
  branch      Branch?              @relation(fields: [branchId], references: [id])
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([branchId])
}

model Member {
  @@schema("food_ordering")
  id        Int      @id @default(autoincrement())
  memberId  String   @unique
  name      String
  phone     String?
  email     String?
  points    Int      @default(0)
  tier      String   @default("bronze")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  @@schema("food_ordering")
  id                   Int                    @id @default(autoincrement())
  username             String                 @unique
  password             String
  pin                  String?                @unique
  role                 UserRole               @default(STAFF)
  name                 String
  isActive             Boolean                @default(true)
  branchId             Int?
  branch               Branch?                @relation(fields: [branchId], references: [id])
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  tableStaffAssignments TableStaffAssignment[]

  @@index([branchId])
}

model TableStaffAssignment {
  @@schema("food_ordering")
  id           Int      @id @default(autoincrement())
  tableNumber  String
  branchId     Int?
  userId       Int
  isActive     Boolean  @default(true)
  checkedInAt  DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  table        Table?   @relation(fields: [branchId, tableNumber], references: [branchId, number], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([branchId, tableNumber, userId])
}

enum MenuType {
  @@schema("food_ordering")
  SINGLE
  SET
  GROUP
}

enum OrderStatus {
  @@schema("food_ordering")
  PREPARING
  COMPLETED
  DELIVERED
  CANCELLED
}

enum QueueStatus {
  @@schema("food_ordering")
  WAITING
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum TableStatus {
  @@schema("food_ordering")
  AVAILABLE
  OCCUPIED
  RESERVED
  BILLING
  CLEANING
}

enum ServiceRequestType {
  @@schema("food_ordering")
  STAFF
  UTENSILS
  PAYMENT
}

enum ServiceRequestStatus {
  @@schema("food_ordering")
  PENDING
  COMPLETED
}

enum UserRole {
  @@schema("food_ordering")
  ADMIN
  STAFF
  CHEF
}

enum IngredientUnit {
  @@schema("food_ordering")
  GRAM
  KILOGRAM
  MILLILITER
  LITER
  PIECE
  TABLESPOON
  TEASPOON
  CUP
}

enum TransactionType {
  @@schema("food_ordering")
  STOCK_IN
  STOCK_OUT
  ORDER_DEDUCTION
  ADJUSTMENT
}

model Ingredient {
  @@schema("food_ordering")
  id           Int                    @id @default(autoincrement())
  name         String
  unit         IngredientUnit
  currentStock Float                  @default(0)
  minStock     Float                  @default(0)
  costPerUnit  Float?
  isActive     Boolean                @default(true)
  branchId     Int?
  branch       Branch?                @relation(fields: [branchId], references: [id])
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  recipes      MenuItemIngredient[]
  transactions InventoryTransaction[]

  @@unique([name, branchId])
  @@index([branchId])
}

model MenuItemIngredient {
  @@schema("food_ordering")
  id           Int        @id @default(autoincrement())
  menuItemId   Int
  ingredientId Int
  quantityUsed Float
  menuItem     MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, ingredientId])
}

model InventoryTransaction {
  @@schema("food_ordering")
  id            Int             @id @default(autoincrement())
  ingredientId  Int
  type          TransactionType
  quantity      Float
  previousStock Float
  newStock      Float
  orderId       String?
  notes         String?
  performedBy   String?
  createdAt     DateTime        @default(now())
  ingredient    Ingredient      @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([ingredientId])
  @@index([type])
  @@index([createdAt])
  @@index([orderId])
}

enum ShiftStatus {
  @@schema("food_ordering")
  OPEN
  CLOSED
}

enum PromotionType {
  @@schema("food_ordering")
  PERCENTAGE
  FIXED_AMOUNT
  COUPON
  HAPPY_HOUR
}

enum PromotionStatus {
  @@schema("food_ordering")
  ACTIVE
  INACTIVE
  EXPIRED
}

enum PaymentMethod {
  @@schema("food_ordering")
  CASH
  TRANSFER
  CREDIT_CARD
}

enum PaymentStatus {
  @@schema("food_ordering")
  PENDING
  PAID
  REFUNDED
}

model Payment {
  @@schema("food_ordering")
  id             Int           @id @default(autoincrement())
  receiptNumber  String        @unique
  orderId        Int
  order          Order         @relation(fields: [orderId], references: [id])
  paymentMethod  PaymentMethod
  paymentStatus  PaymentStatus @default(PENDING)
  subtotal       Float
  serviceCharge  Float         @default(0)
  vat            Float         @default(0)
  discountAmount Float         @default(0)
  discountPoints Int           @default(0)
  totalAmount    Float
  paidAmount     Float         @default(0)
  changeAmount   Float         @default(0)
  memberId       String?
  memberName     String?
  pointsEarned   Int           @default(0)
  cashierName    String?
  note           String?
  paidAt         DateTime?
  branchId       Int?
  branch         Branch?       @relation(fields: [branchId], references: [id])
  shiftId           Int?
  shift             Shift?        @relation(fields: [shiftId], references: [id])
  promotionId       Int?
  promotion         Promotion?    @relation(fields: [promotionId], references: [id])
  promotionDiscount Float         @default(0)
  promotionName     String?
  couponCode        String?
  mergedOrderIds    Int[]
  splitPayments     Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([orderId])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([branchId])
  @@index([shiftId])
  @@index([promotionId])
}

model Shift {
  @@schema("food_ordering")
  id                 Int         @id @default(autoincrement())
  shiftNumber        String      @unique
  status             ShiftStatus @default(OPEN)
  userId             Int
  cashierName        String
  branchId           Int?
  branch             Branch?     @relation(fields: [branchId], references: [id])
  openedAt           DateTime    @default(now())
  closedAt           DateTime?
  openingAmount      Float       @default(0)
  closingAmount      Float?
  expectedCashAmount Float?
  cashDifference     Float?
  totalRevenue       Float?
  totalOrders        Int?
  cashTotal          Float?
  transferTotal      Float?
  creditCardTotal    Float?
  openingCashCount   Json?
  closingCashCount   Json?
  notes              String?
  closingNotes       String?
  payments           Payment[]
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([branchId])
  @@index([status])
  @@index([openedAt])
}

model Promotion {
  @@schema("food_ordering")
  id             Int             @id @default(autoincrement())
  name           String
  description    String?
  type           PromotionType
  status         PromotionStatus @default(ACTIVE)
  discountValue  Float
  maxDiscount    Float?
  couponCode     String?         @unique
  startDate      DateTime
  endDate        DateTime
  startTime      String?
  endTime        String?
  minOrderAmount Float?
  categories     String[]
  maxUses        Int?
  currentUses    Int             @default(0)
  branchId       Int?
  branch         Branch?         @relation(fields: [branchId], references: [id])
  payments       Payment[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([branchId])
  @@index([type])
  @@index([status])
  @@index([startDate, endDate])
}

enum WebhookEvent {
  @@schema("food_ordering")
  ORDER_CREATED
  ORDER_STATUS_CHANGED
  ORDER_CANCELLED
  PAYMENT_COMPLETED
  PAYMENT_REFUNDED
  QUEUE_CREATED
  QUEUE_STATUS_CHANGED
  MEMBER_REGISTERED
  SHIFT_OPENED
  SHIFT_CLOSED
  LOW_STOCK_ALERT
}

model WebhookEndpoint {
  @@schema("food_ordering")
  id          Int               @id @default(autoincrement())
  name        String
  url         String
  secret      String
  events      WebhookEvent[]
  isActive    Boolean           @default(true)
  branchId    Int?
  branch      Branch?           @relation(fields: [branchId], references: [id])
  headers     Json?
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deliveries  WebhookDelivery[]

  @@index([branchId])
  @@index([isActive])
}

model WebhookDelivery {
  @@schema("food_ordering")
  id              Int              @id @default(autoincrement())
  webhookId       Int
  webhook         WebhookEndpoint  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event           WebhookEvent
  payload         Json
  responseStatus  Int?
  responseBody    String?
  success         Boolean          @default(false)
  attempts        Int              @default(1)
  error           String?
  duration        Int?
  createdAt       DateTime         @default(now())

  @@index([webhookId])
  @@index([event])
  @@index([createdAt])
  @@index([success])
}

model TableSession {
  @@schema("food_ordering")
  id                  Int       @id @default(autoincrement())
  tableId             Int
  table               Table     @relation(fields: [tableId], references: [id])
  openedBy            String
  customerCount       Int       @default(1)
  customerGender      String?
  customerNationality String?
  orderType           String    @default("dine_in")
  status              String    @default("OPEN")
  openedAt            DateTime  @default(now())
  closedAt            DateTime?
  branchId            Int?
  branch              Branch?   @relation(fields: [branchId], references: [id])

  @@index([tableId])
  @@index([status])
  @@index([branchId])
}

enum AuditAction {
  @@schema("food_ordering")
  ORDER_CREATED
  ORDER_STATUS_CHANGED
  ORDER_CANCELLED
  ORDER_ITEM_STATUS_CHANGED
  ORDER_SPLIT
  ORDER_TABLE_TRANSFERRED
  PAYMENT_CREATED
  PAYMENT_MERGED
  PAYMENT_REFUNDED
}

enum AuditEntityType {
  @@schema("food_ordering")
  ORDER
  ORDER_ITEM
  PAYMENT
}

model AuditLog {
  @@schema("food_ordering")
  id          Int             @id @default(autoincrement())
  action      AuditAction
  entityType  AuditEntityType
  entityId    Int
  entityRef   String?
  performedBy String?
  branchId    Int?
  oldValues   Json?
  newValues   Json?
  metadata    Json?
  createdAt   DateTime        @default(now())

  @@index([entityType, entityId])
  @@index([action])
  @@index([performedBy])
  @@index([branchId])
  @@index([createdAt])
}

// ==========================================
// Payment Gateway
// ==========================================

enum GatewayTransactionStatus {
  @@schema("food_ordering")
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

model GatewayTransaction {
  @@schema("food_ordering")
  id              Int                      @id @default(autoincrement())
  transactionId   String                   @unique
  paymentMethod   PaymentMethod
  amount          Float
  currency        String                   @default("THB")
  status          GatewayTransactionStatus @default(PENDING)
  provider        String                   @default("mock")
  providerRef     String?
  qrCodeData      String?
  metadata        Json?
  completedAt     DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  branchId        Int?
  branch          Branch?                  @relation(fields: [branchId], references: [id])

  @@index([status])
  @@index([branchId])
}

// ==========================================
// Tax Invoice
// ==========================================

model CompanyTaxInfo {
  @@schema("food_ordering")
  id              Int      @id @default(autoincrement())
  companyName     String
  companyNameEn   String?
  taxId           String
  address         String
  phone           String?
  branchNumber    String   @default("00000")
  branchName      String?
  isHeadOffice    Boolean  @default(true)
  branchId        Int?
  branch          Branch?  @relation(fields: [branchId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([branchId])
}

model TaxInvoice {
  @@schema("food_ordering")
  id              Int       @id @default(autoincrement())
  invoiceNumber   String    @unique
  paymentId       Int
  receiptNumber   String?
  buyerName       String
  buyerTaxId      String
  buyerAddress    String
  buyerBranch     String    @default("00000")
  subtotal        Float
  vatAmount       Float
  totalAmount     Float
  items           Json?
  issuedAt        DateTime  @default(now())
  voidedAt        DateTime?
  voidReason      String?
  branchId        Int?
  branch          Branch?   @relation(fields: [branchId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([paymentId])
  @@index([branchId])
  @@index([issuedAt])
}

// ==========================================
// KDS (Kitchen Display System)
// ==========================================

model KDSStation {
  @@schema("food_ordering")
  id            Int      @id @default(autoincrement())
  name          String
  categories    String[]
  color         String   @default("#3B82F6")
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  alertTimeout  Int      @default(300)
  branchId      Int?
  branch        Branch?  @relation(fields: [branchId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([branchId])
}

// ==========================================
// System Settings
// ==========================================

model SystemSetting {
  @@schema("food_ordering")
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     Json
  branchId  Int?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  updatedAt DateTime @updatedAt

  @@index([branchId])
}
