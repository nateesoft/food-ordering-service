generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["food_ordering"]
}

model MenuItem {
  id                   Int                  @id @default(autoincrement())
  name                 String
  category             String
  price                Float
  image                String?
  description          String?
  rating               Float?
  reviewCount          Int                  @default(0)
  type                 MenuType             @default(SINGLE)
  isActive             Boolean              @default(true)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  availableAddOns      MenuItemAddOn[]
  availableAddOnGroups MenuItemAddOnGroup[]
  nestedMenuConfig     NestedMenuConfig?
  orderItems           OrderItem[]
  setComponents        SetComponent[]

  @@schema("food_ordering")
}

model SetComponent {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  quantity    Int      @default(1)
  menuItemId  Int
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@schema("food_ordering")
}

model AddOn {
  id        Int              @id @default(autoincrement())
  name      String
  price     Float
  category  String
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  groups    AddOnGroupItem[]
  menuItems MenuItemAddOn[]

  @@schema("food_ordering")
}

model AddOnGroup {
  id          Int                  @id @default(autoincrement())
  name        String
  description String?
  price       Float
  category    String
  image       String?
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  items       AddOnGroupItem[]
  menuItems   MenuItemAddOnGroup[]

  @@schema("food_ordering")
}

model AddOnGroupItem {
  id           Int        @id @default(autoincrement())
  addOnId      Int
  addOnGroupId Int
  addOnGroup   AddOnGroup @relation(fields: [addOnGroupId], references: [id], onDelete: Cascade)
  addOn        AddOn      @relation(fields: [addOnId], references: [id], onDelete: Cascade)

  @@unique([addOnId, addOnGroupId])
  @@schema("food_ordering")
}

model MenuItemAddOn {
  id         Int      @id @default(autoincrement())
  menuItemId Int
  addOnId    Int
  addOn      AddOn    @relation(fields: [addOnId], references: [id], onDelete: Cascade)
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, addOnId])
  @@schema("food_ordering")
}

model MenuItemAddOnGroup {
  id           Int        @id @default(autoincrement())
  menuItemId   Int
  addOnGroupId Int
  addOnGroup   AddOnGroup @relation(fields: [addOnGroupId], references: [id], onDelete: Cascade)
  menuItem     MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, addOnGroupId])
  @@schema("food_ordering")
}

model NestedMenuOption {
  id                    Int                      @id @default(autoincrement())
  name                  String
  description           String?
  price                 Float                    @default(0)
  image                 String?
  type                  String                   @default("single")
  requireChildSelection Boolean                  @default(false)
  minChildSelections    Int?
  maxChildSelections    Int?
  parentId              Int?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  rootConfigs           NestedMenuConfigOption[]
  parent                NestedMenuOption?        @relation("NestedOptions", fields: [parentId], references: [id], onDelete: Cascade)
  children              NestedMenuOption[]       @relation("NestedOptions")

  @@schema("food_ordering")
}

model NestedMenuConfig {
  id               Int                      @id @default(autoincrement())
  menuItemId       Int                      @unique
  enabled          Boolean                  @default(true)
  requireSelection Boolean                  @default(true)
  minSelections    Int                      @default(1)
  maxSelections    Int                      @default(1)
  menuItem         MenuItem                 @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  rootOptions      NestedMenuConfigOption[]

  @@schema("food_ordering")
}

model NestedMenuConfigOption {
  id               Int              @id @default(autoincrement())
  configId         Int
  nestedOptionId   Int
  config           NestedMenuConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  nestedMenuOption NestedMenuOption @relation(fields: [nestedOptionId], references: [id], onDelete: Cascade)

  @@unique([configId, nestedOptionId])
  @@schema("food_ordering")
}

model Order {
  id          Int         @id @default(autoincrement())
  orderId     String      @unique
  totalAmount Float
  totalItems  Int
  status      OrderStatus @default(PREPARING)
  tableNumber String?
  staffId     Int?
  staff       User?       @relation("StaffOrders", fields: [staffId], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  items       OrderItem[]

  @@schema("food_ordering")
}

model OrderItem {
  id                    Int      @id @default(autoincrement())
  orderId               Int
  menuItemId            Int
  quantity              Int      @default(1)
  price                 Float
  specialInstructions   String?
  diningOption          String
  status                String   @default("preparing")
  selectedAddOns        Json?
  selectedAddOnGroups   Json?
  selectedNestedOptions Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  menuItem              MenuItem @relation(fields: [menuItemId], references: [id])
  order                 Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@schema("food_ordering")
}

model QueueTicket {
  id            Int         @id @default(autoincrement())
  queueId       String      @unique
  queueNumber   Int
  orderType     String
  totalAmount   Float
  totalItems    Int
  status        QueueStatus @default(WAITING)
  estimatedTime Int?
  customerName  String?
  memberId      String?
  paymentMethod String?
  items         Json
  calledAt      DateTime?
  completedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@schema("food_ordering")
}

model Table {
  id               Int                    @id @default(autoincrement())
  number           String                 @unique
  capacity         Int
  status           TableStatus            @default(AVAILABLE)
  size             String
  positionX        Float
  positionY        Float
  currentGuests    Int?
  mergedWith       Int[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  staffAssignments TableStaffAssignment[]

  @@schema("food_ordering")
}

model ServiceRequest {
  id          Int                  @id @default(autoincrement())
  requestId   String               @unique
  type        ServiceRequestType
  tableNumber String?
  details     String?
  items       String[]
  status      ServiceRequestStatus @default(PENDING)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@schema("food_ordering")
}

model Member {
  id        Int      @id @default(autoincrement())
  memberId  String   @unique
  name      String
  phone     String?
  email     String?
  points    Int      @default(0)
  tier      String   @default("bronze")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("food_ordering")
}

model User {
  id               Int                    @id @default(autoincrement())
  username         String                 @unique
  password         String
  pin              String?                @unique
  role             UserRole               @default(STAFF)
  name             String
  isActive         Boolean                @default(true)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  tableAssignments TableStaffAssignment[]
  ordersHandled    Order[]                @relation("StaffOrders")

  @@schema("food_ordering")
}

model TableStaffAssignment {
  id          Int      @id @default(autoincrement())
  tableNumber String
  userId      Int
  checkedInAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  table       Table    @relation(fields: [tableNumber], references: [number], onDelete: Cascade)

  @@unique([tableNumber, userId])
  @@schema("food_ordering")
}

enum MenuType {
  SINGLE
  SET
  GROUP

  @@schema("food_ordering")
}

enum OrderStatus {
  PREPARING
  COMPLETED
  DELIVERED
  CANCELLED

  @@schema("food_ordering")
}

enum QueueStatus {
  WAITING
  PREPARING
  READY
  COMPLETED
  CANCELLED

  @@schema("food_ordering")
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED

  @@schema("food_ordering")
}

enum ServiceRequestType {
  STAFF
  UTENSILS
  PAYMENT

  @@schema("food_ordering")
}

enum ServiceRequestStatus {
  PENDING
  COMPLETED

  @@schema("food_ordering")
}

enum UserRole {
  ADMIN
  STAFF
  CHEF

  @@schema("food_ordering")
}
