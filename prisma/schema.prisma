generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["food_ordering"]
}

model MenuItem {
  @@schema("food_ordering")
  id                   Int                  @id @default(autoincrement())
  name                 String
  category             String
  price                Float
  image                String?
  description          String?
  rating               Float?
  reviewCount          Int                  @default(0)
  type                 MenuType             @default(SINGLE)
  isActive             Boolean              @default(true)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  availableAddOns      MenuItemAddOn[]
  availableAddOnGroups MenuItemAddOnGroup[]
  nestedMenuConfig     NestedMenuConfig?
  orderItems           OrderItem[]
  setComponents        SetComponent[]
}

model SetComponent {
  @@schema("food_ordering")
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  quantity    Int      @default(1)
  menuItemId  Int
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
}

model AddOn {
  @@schema("food_ordering")
  id        Int              @id @default(autoincrement())
  name      String
  price     Float
  category  String
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  groups    AddOnGroupItem[]
  menuItems MenuItemAddOn[]
}

model AddOnGroup {
  @@schema("food_ordering")
  id          Int                  @id @default(autoincrement())
  name        String
  description String?
  price       Float
  category    String
  image       String?
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  items       AddOnGroupItem[]
  menuItems   MenuItemAddOnGroup[]
}

model AddOnGroupItem {
  @@schema("food_ordering")
  id           Int        @id @default(autoincrement())
  addOnId      Int
  addOnGroupId Int
  addOnGroup   AddOnGroup @relation(fields: [addOnGroupId], references: [id], onDelete: Cascade)
  addOn        AddOn      @relation(fields: [addOnId], references: [id], onDelete: Cascade)

  @@unique([addOnId, addOnGroupId])
}

model MenuItemAddOn {
  @@schema("food_ordering")
  id         Int      @id @default(autoincrement())
  menuItemId Int
  addOnId    Int
  addOn      AddOn    @relation(fields: [addOnId], references: [id], onDelete: Cascade)
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, addOnId])
}

model MenuItemAddOnGroup {
  @@schema("food_ordering")
  id           Int        @id @default(autoincrement())
  menuItemId   Int
  addOnGroupId Int
  addOnGroup   AddOnGroup @relation(fields: [addOnGroupId], references: [id], onDelete: Cascade)
  menuItem     MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, addOnGroupId])
}

model NestedMenuOption {
  @@schema("food_ordering")
  id                    Int                      @id @default(autoincrement())
  name                  String
  description           String?
  price                 Float                    @default(0)
  image                 String?
  type                  String                   @default("single")
  requireChildSelection Boolean                  @default(false)
  minChildSelections    Int?
  maxChildSelections    Int?
  parentId              Int?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  rootConfigs           NestedMenuConfigOption[]
  parent                NestedMenuOption?        @relation("NestedOptions", fields: [parentId], references: [id], onDelete: Cascade)
  children              NestedMenuOption[]       @relation("NestedOptions")
}

model NestedMenuConfig {
  @@schema("food_ordering")
  id               Int                      @id @default(autoincrement())
  menuItemId       Int                      @unique
  enabled          Boolean                  @default(true)
  requireSelection Boolean                  @default(true)
  minSelections    Int                      @default(1)
  maxSelections    Int                      @default(1)
  menuItem         MenuItem                 @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  rootOptions      NestedMenuConfigOption[]
}

model NestedMenuConfigOption {
  @@schema("food_ordering")
  id               Int              @id @default(autoincrement())
  configId         Int
  nestedOptionId   Int
  config           NestedMenuConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  nestedMenuOption NestedMenuOption @relation(fields: [nestedOptionId], references: [id], onDelete: Cascade)

  @@unique([configId, nestedOptionId])
}

model Order {
  @@schema("food_ordering")
  id          Int         @id @default(autoincrement())
  orderId     String      @unique
  totalAmount Float
  totalItems  Int
  status      OrderStatus @default(PREPARING)
  tableNumber String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  items       OrderItem[]
}

model OrderItem {
  @@schema("food_ordering")
  id                    Int      @id @default(autoincrement())
  orderId               Int
  menuItemId            Int
  quantity              Int      @default(1)
  price                 Float
  specialInstructions   String?
  diningOption          String
  status                String   @default("preparing")
  selectedAddOns        Json?
  selectedAddOnGroups   Json?
  selectedNestedOptions Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  menuItem              MenuItem @relation(fields: [menuItemId], references: [id])
  order                 Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model QueueTicket {
  @@schema("food_ordering")
  id            Int         @id @default(autoincrement())
  queueId       String      @unique
  queueNumber   Int
  orderType     String
  totalAmount   Float
  totalItems    Int
  status        QueueStatus @default(WAITING)
  estimatedTime Int?
  customerName  String?
  memberId      String?
  paymentMethod String?
  items         Json
  calledAt      DateTime?
  completedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Table {
  @@schema("food_ordering")
  id            Int         @id @default(autoincrement())
  number        String      @unique
  capacity      Int
  status        TableStatus @default(AVAILABLE)
  size          String
  positionX     Float
  positionY     Float
  currentGuests Int?
  mergedWith    Int[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model ServiceRequest {
  @@schema("food_ordering")
  id          Int                  @id @default(autoincrement())
  requestId   String               @unique
  type        ServiceRequestType
  tableNumber String?
  details     String?
  items       String[]
  status      ServiceRequestStatus @default(PENDING)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model Member {
  @@schema("food_ordering")
  id        Int      @id @default(autoincrement())
  memberId  String   @unique
  name      String
  phone     String?
  email     String?
  points    Int      @default(0)
  tier      String   @default("bronze")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  @@schema("food_ordering")
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  role      UserRole @default(STAFF)
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum MenuType {
  @@schema("food_ordering")
  SINGLE
  SET
  GROUP
}

enum OrderStatus {
  @@schema("food_ordering")
  PREPARING
  COMPLETED
  DELIVERED
  CANCELLED
}

enum QueueStatus {
  @@schema("food_ordering")
  WAITING
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum TableStatus {
  @@schema("food_ordering")
  AVAILABLE
  OCCUPIED
  RESERVED
}

enum ServiceRequestType {
  @@schema("food_ordering")
  STAFF
  UTENSILS
  PAYMENT
}

enum ServiceRequestStatus {
  @@schema("food_ordering")
  PENDING
  COMPLETED
}

enum UserRole {
  @@schema("food_ordering")
  ADMIN
  STAFF
  CHEF
}
